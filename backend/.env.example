# Copie este arquivo para .env e ajuste os valores

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio

# Chave usada para assinar os tokens do painel admin.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Validade do login no painel (horas)
TOKEN_HOURS=12

# Servidor
HOST=127.0.0.1
PORT=5000
DEBUG=true

# Origens liberadas para chamar a API (separadas por vírgula). Use * apenas em desenvolvimento.
CORS_ORIGINS=*

# Endereço público do site (sem barra no final). Usado em canonical, Open Graph e sitemap.xml.
# Vazio: usa o domínio da requisição. Em produção, defina sempre (ex.: https://joederblanca.com.br)
SITE_URL=

# Quando true, o próprio backend também serve a pasta ../frontend
SERVE_FRONTEND=true

# Uploads de imagens do painel
MAX_UPLOAD_MB=5
