# Configuração do deploy com Docker (docker compose). Copie para .env e preencha.
# Gere senhas e chaves com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Porta local onde a aplicação escuta (o Nginx do servidor faz o proxy para ela)
APP_PORT=8082

# Banco MySQL do container (criado automaticamente na primeira inicialização)
DB_USER=portfolio
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Aplicação
SECRET_KEY=
TOKEN_HOURS=12
SITE_URL=https://joederblanca.com.br
CORS_ORIGINS=https://joederblanca.com.br,https://www.joederblanca.com.br
MAX_UPLOAD_MB=5
DEBUG=false
